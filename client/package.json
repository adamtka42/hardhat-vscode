{
  "name": "hardhat-hyperion",
  "publisher": "theqrl",
  "displayName": "Hyperion",
  "description": "Hyperion and Hardhat support for the QRL/Zond ecosystem",
  "license": "MIT",
  "version": "0.8.29",
  "private": true,
  "type": "commonjs",
  "main": "./out/extension.js",
  "module": "./out/extension.js",
  "icon": "docs/images/vscode-logo.png",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "extensionKind": [
    "workspace"
  ],
  "keywords": [
    "hyperion",
    "qrl",
    "zond",
    "hardhat",
    "qrvm",
    "blockchain",
    "compiler"
  ],
  "homepage": "https://theqrl.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/theqrl/hardhat-vscode"
  },
  "bugs": {
    "url": "https://github.com/theqrl/hardhat-vscode/issues"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "activationEvents": [
    "onLanguage:hyperion",
    "workspaceContains:**/hardhat.config.{ts,js}"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "npm run prettier -- --check && npm run eslint",
    "lint:fix": "npm run prettier -- --write && npm run lint -- --fix",
    "eslint": "eslint ./src/**/*.ts",
    "prettier": "prettier *.json \"src/**/*.{ts,js,md,json,yml}\"",
    "clean": "rimraf out tmp tsconfig.tsbuildinfo",
    "prepackage": "npm run clean && node scripts/bundle.js",
    "package": "cd ./tmp && vsce package --no-dependencies --no-yarn -o ..",
    "postpackage": "rimraf ./tmp"
  },
  "devDependencies": {
    "@types/prettier": "2.6.0",
    "@types/vscode": "^1.90",
    "rimraf": "3.0.2",
    "prettier": "2.5.1"
  },
  "dependencies": {
    "@nomicfoundation/solidity-language-server": "0.8.29",
    "@sentry/node": "9.6.1",
    "vscode-languageclient": "9.0.1"
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Hyperion",
      "properties": {
        "hyperion-language-server.trace.server.verbosity": {
          "type": "string",
          "description": "Traces the communication between VS Code and the hyperion language server.",
          "enum": [
            "off",
            "message",
            "verbose"
          ],
          "default": "off"
        },
        "hyperion.telemetry": {
          "type": "boolean",
          "markdownDescription": "Allow **Hyperion** to send extension telemetry.",
          "default": false,
          "tags": [
            "usesOnlineServices",
            "telemetry"
          ]
        },
        "hyperion.formatter": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "prettier"
          ],
          "description": "Enables / disables the hyperion formatter"
        }
      }
    },
    "languages": [
      {
        "id": "hyperion",
        "aliases": [
          "Hyperion",
          "hyperion"
        ],
        "extensions": [
          ".hyp"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hyperion-markdown-injection"
      }
    ],
    "grammars": [
      {
        "language": "hyperion",
        "scopeName": "source.hyperion",
        "path": "./syntaxes/hyperion.json"
      },
      {
        "language": "hyperion-markdown-injection",
        "scopeName": "markdown.hyperion.codeblock",
        "path": "./syntaxes/hyperion-markdown-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.hyperion": "hyperion"
        }
      }
    ],
    "snippets": [
      {
        "language": "hyperion",
        "path": "./snippets/hyperion.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "hardhat",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "%taskdef.task%"
          }
        },
        "when": "shellExecutionSupported"
      }
    ],
    "commands": [
      {
        "command": "hyperion.hardhat.compile",
        "title": "Hardhat: Compile project"
      },
      {
        "command": "hyperion.hardhat.clean",
        "title": "Hardhat: Clear cache and artifacts "
      },
      {
        "command": "hyperion.hardhat.flattenCurrentFile",
        "title": "Hardhat: Flatten this file and its dependencies",
        "enablement": "editorLangId == 'hyperion' && hyperion.inHardhatProject"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hyperion.hardhat.flattenCurrentFile",
          "when": "editorLangId == 'hyperion' && hyperion.inHardhatProject"
        }
      ]
    }
  }
}
