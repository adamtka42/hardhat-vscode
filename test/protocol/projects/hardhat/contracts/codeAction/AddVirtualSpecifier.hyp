pragma hyperion >=0.1.0;

contract Base {
  function mboz() public pure mathsWorks {}

  modifier mathsWorks() {
    require(25 == 25, "happy");
    _;
  }
}

contract Middle is Base {}

contract Bottom is Middle {
  function mboz() public pure override mathsWorks {}
}
