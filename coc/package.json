{
  "name": "@theqrl/coc-hyperion",
  "description": "Hyperion and Hardhat support for coc.nvim",
  "license": "MIT",
  "version": "0.8.29",
  "author": "The QRL contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/theqrl/hardhat-vscode"
  },
  "keywords": [
    "coc.nvim",
    "hyperion",
    "qrl",
    "zond",
    "hardhat"
  ],
  "type": "commonjs",
  "main": "out/index.js",
  "files": [
    "out/index.js"
  ],
  "scripts": {
    "prebundle": "npm run clean",
    "bundle": "esbuild src/index.ts --platform=node --bundle --external:coc.nvim --external:@theqrl/hyperion-language-server --outdir=out",
    "prepack": "npm run bundle",
    "lint": "npm run prettier -- --check && npm run eslint",
    "lint:fix": "npm run prettier --write && npm run eslint --fix",
    "eslint": "eslint --max-warnings 0 \"./src/**/*.ts\"",
    "prettier": "prettier \"*.json\" \"src/**/*.{ts,js,md,json,yml}\"",
    "clean": "rimraf out .nyc_output coverage *.tsbuildinfo *.log"
  },
  "dependencies": {
    "@theqrl/hyperion-language-server": "0.8.29"
  },
  "devDependencies": {
    "coc.nvim": "^0.0.80"
  },
  "engines": {
    "coc": "^0.0.80",
    "node": ">=20.9.0"
  },
  "activationEvents": [
    "onLanguage:hyperion"
  ],
  "contributes": {
    "rootPatterns": [
      {
        "filetype": "hyperion",
        "patterns": [
          ".git/",
          "hardhat.config.js",
          "hardhat.config.ts"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "@theqrl/coc-hyperion configuration",
      "properties": {
        "@theqrl/coc-hyperion.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "Allow this extension to send telemetry. This helps us understand how it is used and how it is performing."
        },
        "@theqrl/coc-hyperion.formatter": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "prettier"
          ],
          "description": "Choose the formatter to use for Hyperion files. 'none' disables formatting and 'prettier' uses Prettier."
        }
      }
    }
  }
}
